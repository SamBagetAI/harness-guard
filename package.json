{
  "name": "harness-guard",
  "version": "0.1.0",
  "description": "Checks an AI agent skill, or your whole Claude Code harness, before you trust it. No dependencies.",
  "type": "module",
  "bin": {
    "harness-guard": "./harness-guard.mjs"
  },
  "files": [
    "harness-guard.mjs",
    "harness.mjs",
    "judge.mjs",
    "common.mjs",
    "scan-worker.mjs"
  ],
  "scripts": {
    "test": "node --test --test-reporter=spec tests/*.test.mjs",
    "examples": "node examples/check.mjs",
    "bench": "node bench/run.mjs",
    "graph": "graphify update .",
    "record": "node scripts/record.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/SamBagetAI/harness-guard"
  },
  "devDependencies": {
    "gifenc": "^1.0.3",
    "playwright-core": "^1.65.1",
    "pngjs": "^7.0.0"
  }
}
